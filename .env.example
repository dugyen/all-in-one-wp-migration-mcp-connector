# WordPress site URL (no trailing slash)
WP_SITE_URL=https://your-wordpress-site.com

# WordPress admin username
WP_USERNAME=your_admin_username

# WordPress Application Password
# Generate one in: WP Admin → Users → Profile → Application Passwords
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: secret token to restrict access to the REST API endpoints
# Set the same value in the plugin's settings if you enable token auth
AI1WM_SECRET_KEY=
